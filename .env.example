# Copy to .env and fill in. .env is gitignored.

# Required: signs login sessions. Generate with: openssl rand -hex 32
JWT_SECRET=

# Recommended: TMDB "API Read Access Token" (https://www.themoviedb.org/settings/api)
# Enables plots, cast, genres, trending and the For You rows.
TMDB_READ_TOKEN=

# Optional: port inside the container
# PORT=3000

# Optional: single sign-on via OIDC (Authentik, Keycloak, ...)
# OIDC_ISSUER_URL=https://your-idp.com/application/o/fleurbox/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CALLBACK_URL=http://localhost:3000/api/auth/oidc/callback
